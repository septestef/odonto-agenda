# Copiá este archivo a .env y completá los valores. El .env real NO se versiona.

# JDBC de PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/turnotarde
# Usuario de la base
DB_USER=turnotarde
# Contraseña de la base (sensible)
DB_PASSWORD=

# Host SMTP
MAIL_HOST=smtp.gmail.com
# Puerto SMTP (STARTTLS)
MAIL_PORT=587
# Cuenta de Gmail que envía
MAIL_USERNAME=
# Contraseña de aplicación de Gmail (sensible)
MAIL_PASSWORD=
# Nombre del remitente
MAIL_FROM_NAME=turnotarde

# URL base para los links de los emails
APP_BASE_URL=http://localhost:8080
# Zona horaria del negocio
APP_TIMEZONE=America/Argentina/Buenos_Aires
# Horizonte máximo de reserva (días)
APP_RESERVA_MAX_DIAS=60

# Contraseña del odontólogo de demo, perfil demo (sensible)
DEMO_PASSWORD=
# Perfil activo
SPRING_PROFILES_ACTIVE=demo

# Tests de integración (opcionales: por defecto usan la base turnotarde_test con DB_USER y DB_PASSWORD)
# JDBC de la base de test
TEST_DB_URL=jdbc:postgresql://localhost:5432/turnotarde_test
# Usuario de la base de test
TEST_DB_USER=turnotarde
# Contraseña de la base de test (sensible). Dejá la línea comentada para reutilizar DB_PASSWORD:
# una variable definida pero vacía pisa el valor por defecto.
# TEST_DB_PASSWORD=
